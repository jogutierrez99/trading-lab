# Export these variables in your shell. The forward runner does not load .env files.
# Public SIGNAL_ONLY market data does not require credentials.
# Private read-only connectivity/reconciliation requires DEMO API credentials.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true
ENVIRONMENT=demo
TRADING_ENABLED=false
ALLOW_LIVE_TRADING=false

# Separate read-only watcher loads these from project .env; shell variables take precedence.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_POLL_SECONDS=2
