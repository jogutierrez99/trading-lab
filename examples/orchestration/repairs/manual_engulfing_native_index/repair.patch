+def test_future_append_preserves_features_and_all_signals():
+    full = candles(150)
+    put(full, 120, ["close", "high"], [50.0, 51.0])
+    expected_features = strategy().prepare_features(full)
+    expected_signals = strategy().generate_signals(full)
+    for stop in (1, 99, 100, 101, 102, 110, 150):
+        prefix = full.iloc[:stop]
+        pd.testing.assert_frame_equal(
+            strategy().prepare_features(prefix), expected_features.iloc[:stop]
+        )
+        actual = strategy().generate_signals(prefix)
+        for field, values in asdict(expected_signals).items():
+            assert getattr(actual, field) == values[:stop]
